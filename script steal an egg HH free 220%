local function GetEggCount()
    local count = 0
    safeCall(function()
        local ls = Player:FindFirstChild("leaderstats")
        if ls then
            for _, stat in ipairs(ls:GetChildren()) do
                local n = stat.Name:lower()
                if (n:find("egg") or n:find("trứng")) and typeof(stat.Value) == "number" then
                    count = stat.Value
                    return
                end
            end
        end
        local bp = Player:FindFirstChildOfClass("Backpack")
        if bp then
            for _, item in ipairs(bp:GetChildren()) do
                local n = item.Name:lower()
                if n:find("egg") or n:find("trứng") then count = count + 1 end
            end
        end
    end)
    return count
end

local function Picked(prompt, before)
    return (not prompt.Parent) or (not prompt:IsDescendantOf(Workspace))
        or (not prompt.Enabled) or GetEggCount() > before
end

local function CollectEgg(egg)
    local prompt = egg.prompt
    local gone = function() return (not prompt.Parent) or (not prompt.Enabled) end

    Farm.status = "Đang bay tới trứng"
    if not FlyTo(egg.pos + Vector3.new(0, 3, 0), Cfg.farmSpeed, gone) then return false end
    if not Farm.enabled then return false end

    Farm.status = "Đang nhặt trứng"
    local before = GetEggCount()

    if Cfg.mode == 1 and fireproximityprompt then
        safeCall(fireproximityprompt, prompt)
        task.wait(Cfg.holdTime)
    else
        local hold = Cfg.holdTime
        local back = math.min(Cfg.backBefore, hold)
        PressE(true)
        task.wait(hold - back)
        local done = true
        if Farm.treadmillPos then
            done = false
            task.spawn(function()
                FlyTo(Farm.treadmillPos, Cfg.farmSpeed)
                done = true
            end)
        end
        task.wait(back)
        PressE(false)
        while not done and Farm.enabled do task.wait() end
    end
    return Picked(prompt, before)
end

function StopFarm()
    Farm.enabled = false
    Farm.status = "Đang tắt"
    PressE(false)
    if Farm.bv then safeCall(function() Farm.bv:Destroy() end) Farm.bv = nil end
    Farm.attempts = {}
    UpdateNoclip()
end

function StartFarm()
    if Farm.enabled then return end
    Exclusive("farm")
    Farm.enabled = true
    Farm.startedAt = os.clock()
    Farm.collected = 0
    if not Farm.treadmillPos then Farm.treadmillPos = RootPart.Position end
    UpdateNoclip()

    safeCall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.2)
    if not Farm.enabled then return end

    Farm.bv = New("BodyVelocity", {
        MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.zero,
    }, RootPart)

    Farm.thread = task.spawn(function()
        local lastReset = os.clock()
        while Farm.enabled and Running() do
            if os.clock() - lastReset > 30 then
                Farm.attempts = {}
                lastReset = os.clock()
            end
            local ok, err = pcall(function()
                local egg = NearestEgg()
                if egg then
                    local success = CollectEgg(egg)
                    if success then
                        Farm.collected = Farm.collected + 1
                        Stats.eggs = Stats.eggs + 1
                        Farm.attempts[egg.prompt] = nil
                    else
                        Farm.attempts[egg.prompt] = (Farm.attempts[egg.prompt] or 0) + 1
                    end
                    if Farm.enabled and Farm.treadmillPos and not NearestEgg() then
                        Farm.status = "Quay về máy chạy bộ"
                        FlyTo(Farm.treadmillPos, Cfg.farmSpeed)
                    end
                    task.wait(0.03)
                else
                    Farm.status = "Chờ trứng xuất hiện..."
                    if Farm.treadmillPos then FlyTo(Farm.treadmillPos, Cfg.farmSpeed) end
                    task.wait(0.4)
                end
            end)
            if not ok then
                warn("[H-HUB] Lỗi farm trứng: " .. tostring(err))
                task.wait(0.3)
            end
        end
    end)
end

