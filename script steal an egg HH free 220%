local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstAncestorWhichIsA("BasePart")
    if p then return p.Position end
    local m = inst:FindFirstAncestorWhichIsA("Model")
    if m then return m:GetPivot().Position end
    return nil
end
 
local function matchesZone(holder)
    if Farm.zone == ALL then return true end
    local targetKey = ""
    for _, z in ipairs(Zones) do
        if z.name == Farm.zone then
            targetKey = z.key:lower()
            break
        end
    end
    local current = holder
    while current and current ~= Workspace do
        local nameLower = current.Name:lower()
        if targetKey ~= "" and nameLower:find(targetKey, 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end
 
local function matchesRarity(holder, prompt)
    if Farm.rarity == "Tất cả độ hiếm" then return true end
    local rarityKeyword = Farm.rarity:match("^(%w+)"):lower()
    local searchString = (prompt.ActionText .. " " .. prompt.ObjectText .. " " .. holder.Name):lower()
    
    for _, attrName in ipairs({"Rarity", "Tier", "EggType", "Quality"}) do
        local attrVal = holder:GetAttribute(attrName) or prompt:GetAttribute(attrName)
        if attrVal and tostring(attrVal):lower():find(rarityKeyword, 1, true) then
            return true
        end
    end
    if searchString:find(rarityKeyword, 1, true) then
        return true
    end
    return false
end
 
local function FindEggs()
    local list = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled and (Farm.attempts[d] or 0) < 3 then
            local holder = d.Parent
            if holder then
                local s = (d.ActionText .. " " .. d.ObjectText .. " " .. holder.Name .. " " ..
                    (holder.Parent and holder.Parent.Name or "")):lower()
                if s:find("egg", 1, true) or s:find("trứng", 1, true) then
                    local pos = getPos(holder)
                    if pos and matchesZone(holder) and matchesRarity(holder, d) then
                        table.insert(list, {prompt = d, pos = pos})
                    end
                end
            end
        end
    end
    return list
end
 
local function NearestEgg()
    local best, bestDist
    for _, e in ipairs(FindEggs()) do
        local dist = (e.pos - RootPart.Position).Magnitude
        if not bestDist or dist < bestDist then
            best, bestDist = e, dist
        end
    end
    return best
end
 
local function CalculateMobRepulsion(targetPos)
    local repulsionOffset = Vector3.zero
    if not Farm.enabled then return targetPos end

    safeCall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= Character then
                local humanoidCheck = obj:FindFirstChildOfClass("Humanoid")
                local rootCheck = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                
                if humanoidCheck and rootCheck and not Players:GetPlayerFromCharacter(obj) then
                    local dist = (RootPart.Position - rootCheck.Position).Magnitude
                    if dist < 12 then
                        local pushDir = (RootPart.Position - rootCheck.Position)
                        pushDir = Vector3.new(pushDir.X, 0, pushDir.Z)
                        if pushDir.Magnitude > 0 then
                            repulsionOffset = repulsionOffset + (pushDir.Unit * (12 - dist) * 0.4)
                        end
                    end
                end
            end
        end
    end)

    return targetPos + repulsionOffset
end
 
local function FlyTo(target, speed)
    speed = speed or Farm.speed
    while Farm.enabled and RootPart and RootPart.Parent do
        local dynamicTarget = CalculateMobRepulsion(target)
        local diff = dynamicTarget - RootPart.Position
        local dist = diff.Magnitude
        if dist < 2 then break end
        local dt = RunService.Heartbeat:Wait()
        local step = math.min(dist, speed * dt)
        RootPart.CFrame = CFrame.new(RootPart.Position + diff.Unit * step)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end
 
local function PressE(down)
    safeCall(function() VIM:SendKeyEvent(down, Enum.KeyCode.E, false, game) end)
end
 
local function GetEggCount()
    local count = 0
    safeCall(function()
        if Player:FindFirstChild("leaderstats") then
            for _, stat in ipairs(Player.leaderstats:GetChildren()) do
                local name = stat.Name:lower()
                if name:find("egg") or name:find("trứng") or name:find("pet") then
                    count = stat.Value
                    return
                end
            end
        end
        if Player:FindFirstChild("Backpack") then
            for _, item in ipairs(Player.Backpack:GetChildren()) do
                if item.Name:lower():find("egg") or item.Name:lower():find("trứng") then
                    count = count + 1
                end
            end
        end
    end)
    return count
end
 
local function CollectEgg(egg)
    FlyTo(egg.pos + Vector3.new(0, 3, 0), Farm.speed)
    if not Farm.enabled then return false end
 
    local eggsBefore = GetEggCount()
 
    if fireproximityprompt and egg.prompt.Parent then
        safeCall(function() fireproximityprompt(egg.prompt) end)
    else
        PressE(true)
        task.wait(0.05)
        PressE(false)
    end
 
    task.wait(Farm.holdTime)
 
    local eggsAfter = GetEggCount()
    local success = (eggsAfter > eggsBefore) or not egg.prompt.Parent 
 
    if success then
        local nextEgg = NearestEgg()
        if nextEgg then
            return true
        end
    end
 
    if Farm.treadmillPos then
        FlyTo(Farm.treadmillPos, Farm.speed)
    end
 
    return success
end
 
local function StopFarm()
    Farm.enabled = false
    PressE(false)
    if Farm.bv then safeCall(function() Farm.bv:Destroy() end) Farm.bv = nil end
    SetNoclip(false)
    Farm.attempts = {}
end
 
local function StartFarm()
    if Farm.enabled then return end
    if Fly.on then
        if FlyToggleRef then FlyToggleRef:SetValue(false) end
        StopFly()
    end
    Farm.enabled = true
    if not Farm.treadmillPos then Farm.treadmillPos = RootPart.Position end
    SetNoclip(true)
 
    safeCall(function()
        if Humanoid then
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    task.wait(0.2)
 
    Farm.bv = Instance.new("BodyVelocity")
    Farm.bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    Farm.bv.Velocity = Vector3.zero
    Farm.bv.Parent = RootPart
 
    Farm.thread = task.spawn(function()
        while Farm.enabled and _G.EggFull_Running do
            local ok, err = pcall(function()
                local egg = NearestEgg()
                if egg then
                    local prompt = egg.prompt
                    Farm.attempts[prompt] = (Farm.attempts[prompt] or 0) + 1
                    CollectEgg(egg)
                    task.wait(0.05)
                else
                    if Farm.treadmillPos then
                        FlyTo(Farm.treadmillPos, Farm.speed)
                    end
                    task.wait(0.5)
                end
            end)
            if not ok then
                warn("[EggFull] Lỗi farm: " .. tostring(err))
                task.wait(0.3)
            end
        end
    end)
end
 
