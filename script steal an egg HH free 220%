        local function playId(id, label, from, to)
            local numeric = tostring(id):match("%d+")
            if not numeric then
                Notify("Lỗi", "Audio ID không hợp lệ: " .. tostring(id))
                return false
            end
            sound.SoundId = "rbxassetid://" .. numeric
            state.CurrentId = numeric
            if from then sound.TimePosition = from end
            local successPlay = pcall(function() sound:Play() end)
            if not successPlay then
                Notify("Lỗi", "Không phát được ID " .. numeric)
                return false
            end
            if from or to then
                task.spawn(function()
                    for _ = 1, 100 do
                        if sound.IsLoaded then break end
                        task.wait(0.1)
                    end
                    if from then sound.TimePosition = from end
                    while sound.Playing and (not to or sound.TimePosition < to) do
                        task.wait(0.1)
                    end
                    if to and sound.Playing then sound:Pause() end
                end)
            end
            Notify("Đang phát", label or ("ID " .. numeric))
            return true
        end

