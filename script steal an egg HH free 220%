local function PickMob()
    local best, bestKey
    local myPos = RootPart.Position
    local hasSel = next(Cfg.mobSel) ~= nil
    local now = os.clock()
    for _, m in ipairs(GetMobs()) do
        local banned = Mob.blacklist[m.model]
        if (not hasSel or Cfg.mobSel[m.name]) and not (banned and banned > now) then
            local dist = (m.root.Position - myPos).Magnitude
            local key
            if Cfg.mobOrder == 1 then key = dist
            elseif Cfg.mobOrder == 2 then key = m.humanoid.Health
            elseif Cfg.mobOrder == 3 then key = -m.humanoid.Health
            else key = -dist end
            if not bestKey or key < bestKey then best, bestKey = m, key end
        end
    end
    return best
end

function StopMob()
    Mob.enabled = false
    Mob.status = "Đang tắt"
    if Mob.bv then safeCall(function() Mob.bv:Destroy() end) Mob.bv = nil end
    safeCall(function()
        Humanoid.WalkSpeed = Cfg.walkOn and Cfg.walkSpeed or OriginalWalkSpeed
    end)
    UpdateNoclip()
end

function StartMob()
    if Mob.enabled then return end
    Exclusive("mob")
    Mob.enabled = true
    Mob.startedAt = os.clock()
    Mob.killed = 0
    Mob.blacklist = {}
    UpdateNoclip()

    Mob.thread = task.spawn(function()
        local toolIdx = 1
        while Mob.enabled and Running() do
            local ok, err = pcall(function()
                local target = PickMob()
                if not target then
                    Mob.status = "Chờ quái xuất hiện..."
                    task.wait(0.3)
                    return
                end
                Mob.status = "Đang đánh: " .. target.name
                local hum, root, model = target.humanoid, target.root, target.model
                local t0 = os.clock()
                local lastSwing = 0

                while Mob.enabled and Running() and hum.Parent and root.Parent and hum.Health > 0
                    and os.clock() - t0 < Cfg.mobTimeout do

                    if Cfg.mobTeleport and not Mob.bv then
                        Mob.bv = New("BodyVelocity", {
                            MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.zero,
                        }, RootPart)
                    elseif not Cfg.mobTeleport and Mob.bv then
                        Mob.bv:Destroy()
                        Mob.bv = nil
                    end

                    local tp = root.Position
                    if Cfg.mobTeleport then
                        local pos = tp + root.CFrame.LookVector * Cfg.attackDist
                        RootPart.CFrame = CFrame.lookAt(pos, Vector3.new(tp.X, pos.Y, tp.Z))
                        RootPart.AssemblyLinearVelocity = Vector3.zero
                    else
                        if (tp - RootPart.Position).Magnitude > Cfg.attackDist then
                            Humanoid:MoveTo(tp)
                        end
                    end

                    if os.clock() - lastSwing >= Cfg.attackDelay then
                        lastSwing = os.clock()
                        local tools = GetWeapons()
                        if #tools > 0 then
                            toolIdx = toolIdx % #tools + 1
                            Swing(tools[toolIdx])
                        end
                    end
                    RunService.Heartbeat:Wait()
                end

                if (not hum.Parent) or hum.Health <= 0 then
                    Mob.killed = Mob.killed + 1
                    Stats.mobs = Stats.mobs + 1
                else
                    Mob.blacklist[model] = os.clock() + 10
                end
            end)
            if not ok then
                warn("[H-HUB] Lỗi farm quái: " .. tostring(err))
                task.wait(0.3)
            end
        end
    end)
end

