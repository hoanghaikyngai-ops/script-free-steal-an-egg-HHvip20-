}

local function StopFly()
    Fly.on = false
    if Fly.conn then Fly.conn:Disconnect() Fly.conn = nil end
    if Fly.bv then safeCall(function() Fly.bv:Destroy() end) Fly.bv = nil end
    SetNoclip(false)
end

local function StartFly()
    if Fly.on then return end
    Fly.on = true
    Fly.bv = Instance.new("BodyVelocity")
    Fly.bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    Fly.bv.Velocity = Vector3.zero
    Fly.bv.Parent = RootPart
    SetNoclip(true)

    Fly.conn = RunService.Heartbeat:Connect(function()
        if not Fly.on or not RootPart or not RootPart.Parent or not Fly.bv then return end
        local move = Humanoid.MoveDirection
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0.01 then Fly.bv.Velocity = move.Unit * Fly.speed else Fly.bv.Velocity = Vector3.zero end
    end)
    Notify("Bay", "Đã BẬT Bay Tự Do [Phím F]")
end

local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstAncestorWhichIsA("BasePart")
    if p then return p.Position end
    return nil
end

local function matchesZone(holder)
    if Farm.zone == ALL then return true end
    local targetKey = ""
    for _, z in ipairs(Zones) do if z.name == Farm.zone then targetKey = z.key:lower() break end end
    local current = holder
    while current and current ~= Workspace do
        if current.Name:lower():find(targetKey, 1, true) then return true end
        current = current.Parent
    end
    return false
end

local function matchesRarity(holder, prompt)
    if Farm.rarity == "Tất cả độ hiếm" then return true end
    local rarityKeyword = Farm.rarity:match("^(%w+)"):lower()
    local searchString = (prompt.ActionText .. " " .. prompt.ObjectText .. " " .. holder.Name):lower()
    if searchString:find(rarityKeyword, 1, true) then return true end
    return false
end

local function FindEggs()
    local list = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local holder = d.Parent
            if holder then
                local s = (d.ActionText .. " " .. d.ObjectText .. " " .. holder.Name):lower()
                if s:find("egg", 1, true) or s:find("trứng", 1, true) then
                    local pos = getPos(holder)
                    if pos and matchesZone(holder) and matchesRarity(holder, d) then
                        table.insert(list, {prompt = d, pos = pos})
                    end
                end
            end
        end
    end
    return list
end

local function NearestEgg()
    local best, bestDist
    for _, e in ipairs(FindEggs()) do
        local dist = (e.pos - RootPart.Position).Magnitude
        if not bestDist or dist < bestDist then best, bestDist = e, dist end
    end
    return best
end

local function FlyTo(target, speed)
    while Farm.enabled and RootPart and RootPart.Parent do
        local diff = target - RootPart.Position
        local dist = diff.Magnitude
        if dist < 2 then break end
        local dt = RunService.Heartbeat:Wait()
        local step = math.min(dist, speed * dt)
        RootPart.CFrame = CFrame.new(RootPart.Position + diff.Unit * step)
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function StopFarm()
    Farm.enabled = false
    if Farm.bv then safeCall(function() Farm.bv:Destroy() end) Farm.bv = nil end
    SetNoclip(false)
end

local function StartFarm()
    if Farm.enabled then return end
    Farm.enabled = true
    if not Farm.treadmillPos then Farm.treadmillPos = RootPart.Position end
    SetNoclip(true)

    Farm.bv = Instance.new("BodyVelocity")
    Farm.bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    Farm.bv.Velocity = Vector3.zero
    Farm.bv.Parent = RootPart

    Farm.thread = task.spawn(function()
        while Farm.enabled and _G.EggFull_Running do
            local ok, err = pcall(function()
                local egg = NearestEgg()
                if egg then
                    FlyTo(egg.pos + Vector3.new(0, 3, 0), Farm.speed)
                    if fireproximityprompt and egg.prompt.Parent then
                        safeCall(function() fireproximityprompt(egg.prompt) end)
                    end
                    task.wait(Farm.holdTime)
                else
                    if Farm.treadmillPos then FlyTo(Farm.treadmillPos, Farm.speed) end
                    task.wait(0.5)
                end
            end)
            if not ok then task.wait(0.3) end
        end
    end)
    Notify("Auto Farm", "Đã BẬT Auto Farm Trứng [Phím G]")
end

