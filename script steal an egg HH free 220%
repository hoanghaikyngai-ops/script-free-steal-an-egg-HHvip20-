local function FormatNum(n)
    if typeof(n) ~= "number" then return tostring(n) end
    local suffix = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
    local neg = n < 0
    n = math.abs(n)
    local i = 1
    while n >= 1000 and i < #suffix do n = n / 1000 i = i + 1 end
    local s = (i == 1) and string.format("%d", math.floor(n)) or string.format("%.2f", n)
    return (neg and "-" or "") .. s .. suffix[i]
end

local function FormatTime(t)
    t = math.floor(t)
    return string.format("%02d:%02d:%02d", math.floor(t / 3600), math.floor(t / 60) % 60, t % 60)
end

