        BackgroundColor3 = C.panel, Position = UDim2.new(1, -34, 0, 4), Size = UDim2.new(0, 30, 1, -8),
        Font = Enum.Font.GothamBold, Text = ">", TextColor3 = C.accent, TextSize = 14,
    }, f)
    Round(right, 5)
    local obj = {Index = index}
    function obj.Set(i, silent)
        if #options == 0 then lbl.Text = text .. ": (trống)" return end
        if i < 1 then i = #options elseif i > #options then i = 1 end
        obj.Index = i
        lbl.Text = text .. ": " .. tostring(options[i])
        if not silent and cb then cb(i, options[i]) end
    end
    function obj.Value() return options[obj.Index] end
    left.MouseButton1Click:Connect(function() obj.Set(obj.Index - 1) end)
    right.MouseButton1Click:Connect(function() obj.Set(obj.Index + 1) end)
    obj.Set(index, true)
    Reg(page, f, text)
    return obj
end

function UI.TextBox(page, placeholder, cb)
    local tb = New("TextBox", {
        BackgroundColor3 = C.item, Size = UDim2.new(1, 0, 0, 32), Font = Enum.Font.Gotham,
        PlaceholderText = placeholder, Text = "", TextColor3 = C.text,
        PlaceholderColor3 = Color3.fromRGB(130, 130, 140), TextSize = 12, ClearTextOnFocus = false,
    }, page)
    Round(tb)
    tb.FocusLost:Connect(function(enter)
