        BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, 12, 0, 24), Size = UDim2.new(1, -24, 0, 26),
    }, f)

    local obj = {Value = def}
    local function fmt(v) return step < 1 and string.format("%.2f", v) or tostring(v) end
    function obj.Set(v, silent)
        v = math.clamp(v, min, max)
        v = math.floor(v / step + 0.5) * step
