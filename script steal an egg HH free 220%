local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstAncestorWhichIsA("BasePart")
    if p then return p.Position end
    local m = inst:FindFirstAncestorWhichIsA("Model")
    if m then return m:GetPivot().Position end
    return nil
end

local function IsEggPrompt(p)
    local holder = p.Parent
    if not holder then return false end
    local s = (p.ActionText .. " " .. p.ObjectText .. " " .. holder.Name .. " " ..
        (holder.Parent and holder.Parent.Name or "")):lower()
    return s:find("egg", 1, true) ~= nil or s:find("trứng", 1, true) ~= nil
end

local function matchesZone(holder, pos)
    if Farm.zone == ALL then return true end
    local c = Cfg.zoneCenters[Farm.zone]
    if c then
        return (pos - Vector3.new(c[1], c[2], c[3])).Magnitude <= Cfg.zoneRadius
    end
    local key = ""
    for _, z in ipairs(Zones) do
        if z.name == Farm.zone then key = z.key break end
    end
    local cur = holder
    while cur and cur ~= Workspace do
        if key ~= "" and cur.Name:lower():find(key, 1, true) then return true end
        cur = cur.Parent
    end
    return false
end

local function FindEggs(ignoreZone)
    local list = {}
    for p in pairs(Prompts) do
        if p.Parent and p.Enabled and (ignoreZone or (Farm.attempts[p] or 0) < 3) and IsEggPrompt(p) then
            local pos = getPos(p.Parent)
            if pos and (ignoreZone or matchesZone(p.Parent, pos)) then
                table.insert(list, {prompt = p, pos = pos})
            end
        end
    end
    return list
end

local function NearestEgg()
    local best, bestDist
    for _, e in ipairs(FindEggs()) do
        local d = (e.pos - RootPart.Position).Magnitude
        if not bestDist or d < bestDist then best, bestDist = e, d end
    end
    return best, bestDist
end

local function MobName(model)
