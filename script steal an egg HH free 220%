local function Repel(target)
    local offset = Vector3.zero
    local myPos = RootPart.Position
    for h in pairs(Humanoids) do
        local m = h.Parent
        if m and m ~= Character and not Players:GetPlayerFromCharacter(m) then
            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if r then
                local diff = myPos - r.Position
                local dist = diff.Magnitude
                if dist < 12 then
                    local push = Vector3.new(diff.X, 0, diff.Z)
                    if push.Magnitude > 0.01 then
                        offset = offset + push.Unit * (12 - dist) * 0.4
                    end
                end
            end
        end
    end
    return target + offset
end

local function FlyTo(target, speed, abort)
    speed = speed or Cfg.farmSpeed
    local deadline = os.clock() + ((target - RootPart.Position).Magnitude / speed) + 3
    while Farm.enabled and RootPart and RootPart.Parent do
        if abort and abort() then return false end
        if os.clock() > deadline then return false end
        local realDist = (target - RootPart.Position).Magnitude
        if realDist < 2 then return true end
        local goal = target
        if Cfg.avoidMobs and realDist > 8 then goal = Repel(target) end
        local diff = goal - RootPart.Position
        local dist = diff.Magnitude
        if dist < 0.01 then return true end
        local dt = RunService.Heartbeat:Wait()
        local step = math.min(dist, speed * dt)
        RootPart.CFrame = CFrame.new(RootPart.Position + diff.Unit * step) * RootPart.CFrame.Rotation
        RootPart.AssemblyLinearVelocity = Vector3.zero
    end
    return false
end

