    end)
    Reg(page, tb, placeholder)
    return tb
end

function UI.Multi(page, text, getOptions, selected, onChange, emptyLabel)
    local container = New("Frame", {
        BackgroundColor3 = C.item, Size = UDim2.new(1, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.Y,
    }, page)
    Round(container)
    New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, container)
    local header = New("TextButton", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Font = Enum.Font.GothamBold,
        TextColor3 = C.text, TextSize = 12, Text = "", LayoutOrder = 0,
    }, container)
    local holder = New("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false, LayoutOrder = 1,
    }, container)
    New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3)}, holder)
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
    }, holder)

    local open = false
    local function count()
        local n = 0
        for _ in pairs(selected) do n = n + 1 end
        return n
    end
    local function updateHeader()
        local n = count()
        header.Text = text .. ": " .. (n > 0 and (n .. " đã chọn") or (emptyLabel or "chưa chọn"))
            .. (open and "  ▲" or "  ▼")
    end

    local function rebuild()
        for _, ch in ipairs(holder:GetChildren()) do
            if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
        end
        local order = 0
        local function mkBtn(label, color, cbk)
            order = order + 1
            local b = New("TextButton", {
                BackgroundColor3 = C.panel, Size = UDim2.new(1, 0, 0, 26), Font = Enum.Font.Gotham,
                Text = label, TextColor3 = color or C.text, TextSize = 11, LayoutOrder = order,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, holder)
            Round(b, 5)
            New("UIPadding", {PaddingLeft = UDim.new(0, 8)}, b)
            b.MouseButton1Click:Connect(function() cbk(b) end)
            return b
        end
        mkBtn("↻ Làm mới danh sách", C.accent, function() rebuild() end)
        mkBtn("✕ Bỏ chọn tất cả", C.off, function()
            for k in pairs(selected) do selected[k] = nil end
            if onChange then onChange() end
            updateHeader()
            rebuild()
        end)
        local opts = getOptions()
        for _, name in ipairs(opts) do
            mkBtn((selected[name] and "[x] " or "[  ] ") .. name, nil, function(b)
                selected[name] = (not selected[name]) or nil
                b.Text = (selected[name] and "[x] " or "[  ] ") .. name
                if onChange then onChange() end
                updateHeader()
            end)
        end
    end

    header.MouseButton1Click:Connect(function()
        open = not open
        holder.Visible = open
        if open then rebuild() end
        updateHeader()
    end)
    updateHeader()
    Reg(page, container, text)
end

