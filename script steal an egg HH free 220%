local function RefreshPage(page)
    local meta = PageMeta[page]
    if not meta then return end
    local filtering = FilterText ~= ""
    local hasMatch = {}
    for _, it in ipairs(meta.items) do
        local match = (not filtering) or it.name:find(FilterText, 1, true) ~= nil
            or (it.section ~= nil and it.section.title:lower():find(FilterText, 1, true) ~= nil)
        local vis = match
        if not filtering and it.section and it.section.collapsed then vis = false end
        it.frame.Visible = vis
        if match and it.section then hasMatch[it.section] = true end
    end
    for _, sec in ipairs(meta.sections) do
        sec.header.Visible = (not filtering) or hasMatch[sec] == true
            or sec.title:lower():find(FilterText, 1, true) ~= nil
    end
end

